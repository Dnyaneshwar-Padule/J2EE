<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="https://jakarta.ee/xml/ns/jakartaee" xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_5_0.xsd" id="WebApp_ID" version="5.0">
  <display-name>05-Servlet-Initialization-Parameters</display-name>
  <welcome-file-list>
    <welcome-file>get</welcome-file>
  </welcome-file-list>
  
  <servlet>
  	<servlet-name>simpleServlet</servlet-name>
  	<servlet-class>com.tca.controller.SimpleServlet</servlet-class>
  
  	<init-param>
  		<param-name>servlet-name</param-name>
  		<param-value>___simpleeeee____servlettt__</param-value>
  	</init-param> 
  	  	<init-param>
  		<param-name>servlet-class</param-name>
  		<param-value>com.tca.controller.SimpleServlet</param-value>
  	</init-param> 
  	 <init-param>
  		<param-name>http-method</param-name>
  		<param-value>get</param-value>
  	</init-param> 
  </servlet>
  
  <servlet-mapping>
  		<servlet-name>simpleServlet</servlet-name>
  		<url-pattern>/get</url-pattern>
  </servlet-mapping>
  
  
</web-app>